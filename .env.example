# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=auth-local

# auth-local listen addresses
# AUTH_GRPC_ADDR=:9403
# AUTH_HTTP_ADDR=:9401

# SQLite store (default: ~/.muxcore/auth.db)
# AUTH_DB_PATH=/var/lib/muxcore/auth.db

# RBAC policy YAML (default: policies.yaml; missing → builtin admin/manager/user/viewer)
# AUTH_POLICY_FILE=policies.yaml

# WebAuthn relying party (defaults: localhost / http://localhost:9401 / MuxCore)
# AUTH_RP_ID=localhost
# AUTH_RP_ORIGINS=http://localhost:9401
# AUTH_RP_NAME=MuxCore

# Comma-separated CIDRs trusted for X-Forwarded-For (default: loopback)
# AUTH_TRUSTED_PROXIES=127.0.0.0/8,10.0.0.0/8

# authctl admin token (optional)
# AUTHCTL_TOKEN=
